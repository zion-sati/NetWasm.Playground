<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>NetWasm.Playground.NativeAotCompilerHost</AssemblyName>
    <RootNamespace>NetWasm.Playground.NativeAotCompilerHost</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <EmccInitialHeapSize>268435456</EmccInitialHeapSize>
    <DefineConstants>$(DefineConstants);NATIVEAOT_LLVM;FRONTEND_CACHE_TRANSPORT</DefineConstants>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <RoslynCompilerPath Condition="'$(RoslynCompilerPath)' == ''">$(MSBuildSDKsPath)/../Roslyn/bincore</RoslynCompilerPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../compiler-host/Program.cs" Link="CompilerHostProgram.cs" />
    <Compile Include="../compiler-host/TrustedGeneratorAssets.cs" Link="TrustedGeneratorAssets.cs" />
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="[$(NativeAotLlvmVersion)]" />
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM"
                      Version="[$(NativeAotLlvmVersion)]" />
    <PackageReference Include="NetWasm.Compiler.Browser" Version="[$(NetWasmCompilerPackageVersion)]" />
    <PackageReference Include="NetWasm.Runtime.Pack" Version="[$(NetWasmCompilerPackageVersion)]" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(RoslynCompilerPath)/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(RoslynCompilerPath)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
    <LinkerArg Include="-sALLOW_MEMORY_GROWTH=1" />
    <LinkerArg Include="-sMAXIMUM_MEMORY=2147483648" />
    <LinkerArg Include="-sMODULARIZE=1" />
    <LinkerArg Include="-sEXPORT_ES6=1" />
    <LinkerArg Include="-sEXPORT_NAME=createNetWasmCompilerModule" />
    <LinkerArg Include="-sENVIRONMENT=web,worker" />
  </ItemGroup>
</Project>
