<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CompressionEnabled>false</CompressionEnabled>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>NetWasm.Playground.CompilerProbe</AssemblyName>
    <RootNamespace>NetWasm.Playground.CompilerProbe</RootNamespace>
    <WasmBuildNative>false</WasmBuildNative>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);FRONTEND_CACHE_TRANSPORT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
    <PackageReference Include="NetWasm.Compiler.Browser"
                      Version="[$(NetWasmCompilerPackageVersion)]" />
    <PackageReference Include="NetWasm.Runtime.Pack"
                      Version="[$(NetWasmCompilerPackageVersion)]" />
  </ItemGroup>
</Project>
